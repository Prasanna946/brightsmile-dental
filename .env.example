# ================================
# BrightSmile Dental - Environment Config
# ================================
# Copy this file as .env and fill in your values:
#   cp .env.example .env
#
# ⚠️ NEVER commit your .env file to GitHub!
# ================================

# Database (SQLite path)
DATABASE_URL=file:./db/custom.db

# EmailJS - Email Notifications
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id

# Twilio - WhatsApp Notifications
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890
CLINIC_WHATSAPP_NUMBER=whatsapp:+919999999999

# Clinic Email (doctor receives appointment notifications here)
CLINIC_EMAIL=doctor@brightsmile.dental

# Resend - Patient Email Notifications (bulletproof deliverability)
RESEND_API_KEY=re_your_resend_api_key
